import Lean
open Lean

/-!
Trust audit of the compiled package. Run: `lake env lean --run Audit.lean [Module ...]` (default module: `RcsrCore`).

Prints one line per theorem under the namespace `Rcsr`, sorted: `<full name> <kernel|bv_decide>`.
Exit 0 when every theorem depends only on allowed names; exit 1 otherwise, with the offending names on stderr.
-/

/-- The three standard names every Lean development may depend on. -/
def standardNames : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- A name generated by one use of the SAT tactic: `<declaration>._native.bv_decide.ax_<n>_<m>`. -/
def isSatName (n : Name) : Bool :=
  (n.toString.splitOn "._native.bv_decide.ax_").length == 2

def main (args : List String) : IO UInt32 := do
  initSearchPath (← findSysroot)
  let mods := if args.isEmpty then [`RcsrCore] else args.map String.toName
  let env ← importModules (mods.toArray.map fun m => { module := m }) {}
  let root := `Rcsr
  let mut names : Array Name := #[]
  for (n, ci) in env.constants.toList do
    if root.isPrefixOf n && !n.isInternalDetail then
      if let .thmInfo _ := ci then names := names.push n
  names := names.qsort (fun a b => a.toString < b.toString)
  let mut bad : Array String := #[]
  for n in names do
    let (axs, _) ← (collectAxioms n : CoreM (Array Name)).toIO
      { fileName := "<audit>", fileMap := default } { env := env }
    let other := axs.filter fun a => !standardNames.contains a && !isSatName a
    let cls := if axs.any isSatName then "bv_decide" else "kernel"
    IO.println s!"{n} {cls}"
    if !other.isEmpty then bad := bad.push s!"{n}: {other.toList}"
  if !bad.isEmpty then
    IO.eprintln s!"rcsr_audit: names outside the allow-list:\n{String.intercalate "\n" bad.toList}"
    return 1
  IO.eprintln s!"rcsr_audit: {names.size} theorems, allow-list holds"
  return 0
